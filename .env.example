# SQLite 路径以 prisma/schema.prisma 所在目录为基准。
DATABASE_URL="file:../data/speech-asset-lab.db"

# RC2 云端内置资产迁移仅在本机执行。不要提交真实连接串，也不要把它放到浏览器环境。
CLOUD_DATABASE_URL=

# 线上试用版在 Cloudflare 以公开变量 APP_VARIANT=cloud-trial 运行。
# 本机完整工作台保持 local；不要在此填写线上密钥。
NEXT_PUBLIC_APP_VARIANT=local

# 云端私有文档导入：仅服务端使用 Supabase secret/service_role key；
# 禁止使用 NEXT_PUBLIC_ 前缀，禁止提交真实值。
CLOUD_IMPORT_ENABLED="false"
NEXT_PUBLIC_CLOUD_IMPORT_ENABLED="false"
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 云端接收 UTF-8 TXT、PDF、Word（.docx）；默认单文件 10 MiB、单批 25 MiB、最多 5 个文件。
CLOUD_IMPORT_MAX_FILES="5"
CLOUD_IMPORT_MAX_FILE_BYTES="10485760"
CLOUD_IMPORT_MAX_BATCH_BYTES="26214400"
# PDF/Word 由 Cloudflare AI 文档转换处理；扫描 PDF 在文字层缺失时通过 OCR.Space 兜底。
# OCR_SPACE_API_KEY 只能作为 Cloudflare Secret 设置，不能提交。免费 OCR 的单文件限制默认 1 MiB、最多 3 页。
OCR_SPACE_API_KEY=
CLOUD_OCR_MAX_FILE_BYTES="1048576"
CLOUD_OCR_MAX_PAGES="3"

# 所有目录均保留在本机；不要填写云端存储地址。
APP_DATA_DIR="./data"
APP_FILES_DIR="./data/files"
APP_LOGS_DIR="./data/logs"
APP_BACKUPS_DIR="./data/backups"

# F1 导入安全限额。默认值来自 D-045，可按本机剩余空间和课程规模调整。
IMPORT_MAX_FILES="100"
IMPORT_MAX_FILE_BYTES="26214400"
IMPORT_MAX_BATCH_BYTES="209715200"
IMPORT_MAX_ZIP_COMPRESSION_RATIO="100"

# 仅预留 Provider 配置；真实 Key 只能保存在本机 .env，绝不提交。
AI_PROVIDER="deepseek"
AI_BASE_URL="https://api.deepseek.com"
AI_MODEL="deepseek-chat"
AI_API_KEY=""
# 可选：本地 PDF 文本提取使用的 Python 可执行文件（需已安装 pypdf）。未设置时会尝试本机运行时。
PDF_PYTHON_EXECUTABLE=

# 扫描型 PDF 的纯本地 OCR 回退。未设置时会尝试常见本机安装位置。
OCR_TESSERACT_EXECUTABLE=
PDF_POPPLER_EXECUTABLE=
# OCR 页面渲染分辨率。300 适合英文小字；可在 200-450 之间按速度与清晰度权衡。
OCR_RENDER_DPI="300"
# Tesseract 会自动选择已安装的 eng 或 eng+chi_sim；如需固定可在此填写。
OCR_TESSERACT_LANGUAGE=
# 未安装 Tesseract 时，Windows 版会优先英文并回退中文。填写后固定使用该语言包。
OCR_POWERSHELL_EXECUTABLE=
OCR_WINDOWS_LANGUAGE=
